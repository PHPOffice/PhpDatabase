{
    "name": "phpoffice/phpdatabase",
    "description": "PhpOffice\\PhpDatabase - Read, Create and Write database documents (ACCDB, ODB, SQLite) in PHP",
    "keywords": ["PHP", "database", "accdb", "access", "odb", "base", "libreoffice", "hsqldb", "sqlite"],
    "homepage": "https://phpoffice.github.io",
    "type": "library",
    "license": "LGPL-3.0-only",
    "authors": [
        {
            "name": "Franck Lefevre",
            "homepage": "https://rootslabs.net"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ext-zlib": "*",
        "phpoffice/common": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "phpmd/phpmd": "2.*"
    },
    "autoload": {
        "psr-4": {
            "PhpOffice\\PhpDatabase\\": "src/PhpDatabase/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpOffice\\PhpDatabase\\Tests\\": "tests/PhpDatabase/Tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "samples": [
            "php samples/Sample_01_Create.php",
            "php samples/Sample_02_Convert.php",
            "php samples/Sample_03_Read.php"
        ]
    }
}
